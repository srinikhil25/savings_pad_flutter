rules_version = '2';

// Paste into: Firebase console -> Firestore Database -> Rules -> Publish.
//
// Lecture 09 demonstrates this rule:
//
//   match /{document=**} { allow read, write: if request.auth != null; }
//
// and states plainly that it "is not secure, but use it to simplify the
// exercise in education" — any signed-in user could read every other user's
// documents.
//
// Because this app stores data under users/{uid}/..., the rule can compare the
// caller's uid to the path and be genuinely per-user, at no extra complexity.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Anything outside a user's own subtree is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
